        <td>{{system.equipped.waist.name}}</td>
        <td>{{system.equipped.waist.system.special}}</td>
        <td>
          <!-- Placeholder for actions, can be expanded later -->
        </td>
      </tr>
      <tr>
        <td><img src="systems/utopia/assets/icons/rpg-icons/hand.png"></td>
        <td>{{localize "UTOPIA.EQUIPMENT.HANDS"}}</td>
        <td>{{system.equipped.hands.name}}</td>
        <td>{{system.equipped.hands.system.special}}</td>
        <td>
          <!-- Placeholder for actions, can be expanded later -->
