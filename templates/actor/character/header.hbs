        <td>{{system.equipped.back.name}}</td>
        <td>{{system.equipped.back.system.special}}</td>
        <td>
          <!-- Placeholder for actions, can be expanded later -->
        </td>
      </tr>
      <tr>
        <td><img src="systems/utopia/assets/icons/rpg-icons/relic.png"></td>
