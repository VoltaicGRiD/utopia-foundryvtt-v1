<div class="tab details {{tab.cssClass}}" data-group="primary" data-tab="details">
  <div class="actor-traits" style="margin-top: 10px;">
    <a class="edit-section-button" data-action="selectSubtraits" data-tooltip="{{localize "
      UTOPIA.Actors.editTraits"}}"><i class="fas fa-pen-to-square fa-fw"></i></a>
      {{log traits}}
    {{> "actor-trait" trait=traits.agi subtraitLeft=traits.spd subtraitRight=traits.dex}}
    {{> "actor-trait" trait=traits.str subtraitLeft=traits.pow subtraitRight=traits.for}}
    {{> "actor-trait" trait=traits.int subtraitLeft=traits.eng subtraitRight=traits.mem}}
    {{> "actor-trait" trait=traits.wil subtraitLeft=traits.res subtraitRight=traits.awa}}
    {{> "actor-trait" trait=traits.dis subtraitLeft=traits.por subtraitRight=traits.stu}}
    {{> "actor-trait" trait=traits.cha subtraitLeft=traits.app subtraitRight=traits.lan}}
  </div>

  <div class="point-blocks">
    <fieldset>
      <legend>{{localize 'UTOPIA.LABELS.Points'}}</legend>
      <div class="flexrow data-blocks">

        <div class="data-overlay">
          <i class="fa-solid fa-shield fa-fw" data-tooltip="{{localize 'UTOPIA.Actors.Points.body'}}"></i>
          <span class="data-number">
            {{numberFormat system.body decimals=0}}
          </span>
        </div>

        <div class="data-overlay">
          <i class="fa-solid fa-brain fa-fw" data-tooltip="{{localize 'UTOPIA.Actors.Points.mind'}}"></i>
          <span class="data-number">
            {{numberFormat system.mind decimals=0}}
          </span>
        </div>

        <div class="data-overlay">
          <i class="fa-solid fa-flame fa-fw" data-tooltip="{{localize 'UTOPIA.Actors.Points.soul'}}"></i>
          <span class="data-number">
            {{numberFormat system.soul decimals=0}}
          </span>
        </div>

      </div>
    </fieldset>

    <fieldset>
      <legend>{{localize 'UTOPIA.LABELS.Attributes'}}</legend>
      <div class="flexrow data-blocks">

        <div class="data-overlay">
          <i class="fa-solid fa-block-brick fa-fw"
            data-tooltip="{{localize 'UTOPIA.Actors.Attributes.constitution'}}"></i>
          <span class="data-number">
            {{numberFormat system.constitution decimals=0}}
          </span>
        </div>

        <div class="data-overlay">
          <i class="fa-solid fa-rabbit-running fa-fw"
            data-tooltip="{{localize 'UTOPIA.Actors.Attributes.endurance'}}"></i>
          <span class="data-number">
            {{numberFormat system.endurance decimals=0}}
          </span>
        </div>

        <div class="data-overlay">
          <i class="fa-solid fa-sparkles fa-fw" data-tooltip="{{localize 'UTOPIA.Actors.Attributes.effervescence'}}"></i>
          <span class="data-number">
            {{numberFormat system.effervescence decimals=0}}
          </span>
        </div>

      </div>
    </fieldset>

    <fieldset>
      <legend>{{localize 'UTOPIA.LABELS.Travel'}}</legend>
      <div class="flexrow data-blocks">

        <div class="data-overlay">
          <i class="fa-solid fa-mountain fa-fw" data-tooltip="{{localize 'UTOPIA.Actors.Travel.land'}}"></i>
          <span class="data-number">
            {{numberFormat system.travel.land.total decimals=0}}
          </span>
        </div>

        <div class="data-overlay">
          <i class="fa-solid fa-person-swimming fa-fw" data-tooltip="{{localize 'UTOPIA.Actors.Travel.water'}}"></i>
          <span class="data-number">
            {{numberFormat system.travel.water.total decimals=0}}
          </span>
        </div>

        <div class="data-overlay">
          <i class="fa-solid fa-person-fairy fa-fw" data-tooltip="{{localize 'UTOPIA.Actors.Travel.air'}}"></i>
          <span class="data-number">
            {{numberFormat system.travel.air.total decimals=0}}
          </span>
        </div>

      </div>
    </fieldset>

    <fieldset>
      <legend>{{localize 'UTOPIA.LABELS.Defenses'}}</legend>

      <div class="flexrow data-blocks">
        <div class="data-overlay">
          <i class="fa-solid fa-snowflake fa-fw" data-tooltip="{{localize 'UTOPIA.Actors.Defenses.chill'}}"></i>
          <span class="data-number">
            {{numberFormat system.defenses.chill.total decimals=0}}
          </span>
        </div>

        <div class="data-overlay">
          <i class="fa-solid fa-bolt fa-fw" data-tooltip="{{localize 'UTOPIA.Actors.Defenses.energy'}}"></i>
          <span class="data-number">
            {{numberFormat system.defenses.energy.total decimals=0}}
          </span>
        </div>

        <div class="data-overlay">
          <i class="fa-solid fa-fire fa-fw" data-tooltip="{{localize 'UTOPIA.Actors.Defenses.heat'}}"></i>
          <span class="data-number">
            {{numberFormat system.defenses.heat.total decimals=0}}
          </span>
        </div>

        <div class="data-overlay">
          <i class="fa-solid fa-hand-fist fa-fw" data-tooltip="{{localize 'UTOPIA.Actors.Defenses.physical'}}"></i>
          <span class="data-number">
            {{numberFormat system.defenses.physical.total decimals=0}}
          </span>
        </div>

        <div class="data-overlay">
          <i class="fa-solid fa-brain fa-fw" data-tooltip="{{localize 'UTOPIA.Actors.Defenses.psyche'}}"></i>
          <span class="data-number">
            {{numberFormat system.defenses.psyche.total decimals=0}}
          </span>
        </div>
      </div>
    </fieldset>
  </div>

  
</div>